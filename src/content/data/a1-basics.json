  {
    "id": "a1-articles",
    "title": "a, an, the",
    "fr": "Articles : a/an pour une chose quelconque, the pour une chose précise.",
    "points": [
      {
        "rule": "a + consonant sound",
        "example": "a book, a university"
      },
      {
        "rule": "an + vowel sound",
        "example": "an apple, an hour"
      },
      {
        "rule": "the = the one we know",
        "example": "The book on the table is mine."
      }
    ],
    "trap": {
      "wrong": "She is engineer.",
      "right": "She is an engineer."
    },
    "items": [
      {
        "id": "a1ar-1",
        "type": "mcq",
        "prompt": "I have ___ orange.",
        "options": [
          "a",
          "an",
          "the",
          "—"
        ],
        "answer": 1,
        "explanation": "Vowel sound → an."
      },
      {
        "id": "a1ar-2",
        "type": "mcq",
        "prompt": "He is ___ doctor.",
        "options": [
          "a",
          "an",
          "the",
          "—"
