          "a",
          "an",
          "the",
          "—"
        ],
        "answer": 2,
        "explanation": "A specific door → the."
      },
      {
        "id": "a1ar-4",
        "type": "mcq",
        "prompt": "It takes ___ hour.",
        "options": [
          "a",
          "an",
          "the",
          "—"
        ],
        "answer": 1,
        "explanation": "Hour starts with a vowel sound → an hour."
      },
      {
        "id": "a1ar-5",
        "type": "truefalse",
        "prompt": "\"a university\" is correct.",
        "answer": true,
        "explanation": "University starts with a /j/ sound → a."
      },
      {
        "id": "a1ar-6",
        "type": "gap",
        "prompt": "She is ___ English teacher.",
        "accepted": [
          "an"
        ],
        "explanation": "English starts with a vowel sound → an."
      },
      {
        "id": "a1ar-7",
        "type": "mcq",
        "prompt": "___ sun is hot today.",
        "options": [
          "A",
          "An",
          "The",
          "—"
        ],
        "answer": 2,
        "explanation": "Only one sun → the."
      },
      {
        "id": "a1ar-8",
        "type": "truefalse",
        "prompt": "\"I am student\" is correct.",
        "answer": false,
        "explanation": "I am a student."
