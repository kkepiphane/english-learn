[
  {
    "id": "a1-be",
    "title": "be: am, is, are",
    "fr": "Le verbe être au présent.",
    "points": [
      {
        "rule": "I am · you/we/they are · he/she/it is",
        "example": "I am Togolese. They are students."
      },
      {
        "rule": "Negative: add not (isn't, aren't)",
        "example": "She isn't at home."
      },
      {
        "rule": "Question: put be first",
        "example": "Are you ready?"
      }
    ],
    "trap": {
      "wrong": "I have 20 years.",
      "right": "I am 20 (years old)."
    },
    "items": [
      {
        "id": "a1be-1",
        "type": "mcq",
        "prompt": "She ___ a nurse.",
        "options": [
          "am",
          "is",
          "are",
          "be"
        ],
        "answer": 1,
        "explanation": "he/she/it → is."
      },
      {
        "id": "a1be-2",
        "type": "mcq",
        "prompt": "We ___ from Lomé.",
        "options": [
          "is",
          "am",
          "are",
          "be"
        ],
        "answer": 2,
        "explanation": "we → are."
      },
      {
        "id": "a1be-3",
        "type": "mcq",
        "prompt": "___ you tired?",
        "options": [
          "Is",
          "Are",
          "Am",
          "Do"
        ],
        "answer": 1,
        "explanation": "Questions with be: Are you…?"
      },
      {
        "id": "a1be-4",
        "type": "gap",
        "prompt": "I ___ 25 years old.",
        "accepted": [
          "am",
          "'m"
        ],
        "explanation": "Age uses be: I am 25."
      },
      {
        "id": "a1be-5",
        "type": "truefalse",
        "prompt": "\"He are my brother\" is correct.",
        "answer": false,
        "explanation": "he → is: He is my brother."
      },
      {
        "id": "a1be-6",
        "type": "mcq",
        "prompt": "They ___ at school today. (negative)",
        "options": [
          "isn't",
          "aren't",
          "not are",
          "don't"
        ],
        "answer": 1,
        "explanation": "they → aren't."
      },
      {
        "id": "a1be-7",
        "type": "mcq",
        "prompt": "It ___ cold today.",
        "options": [
          "is",
          "are",
          "am",
          "have"
        ],
        "answer": 0,
        "explanation": "it → is."
      },
      {
        "id": "a1be-8",
        "type": "truefalse",
        "prompt": "\"I am hungry\" is correct.",
        "answer": true,
        "explanation": "Hunger uses be in English, not have."
      }
    ]
  },
  {
    "id": "a1-present",
    "title": "Present simple",
    "fr": "Habitudes et vérités. N'oubliez pas le -s à la 3e personne.",
    "points": [
      {
        "rule": "he / she / it + verb-s",
        "example": "She works in a bank."
      },
      {
        "rule": "Negative: don't / doesn't + verb",
        "example": "He doesn't like coffee."
      },
      {
        "rule": "Question: Do / Does + subject + verb",
        "example": "Does she speak English?"
      }
    ],
    "trap": {
      "wrong": "He don't eat meat.",
      "right": "He doesn't eat meat."
    },
    "items": [
