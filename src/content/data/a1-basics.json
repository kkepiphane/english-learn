  {
    "id": "a1-plurals",
    "title": "Plurals, this and these",
    "fr": "Pluriels réguliers et irréguliers ; this/that au singulier, these/those au pluriel.",
    "points": [
      {
        "rule": "Most nouns + s · -s/-sh/-ch/-x + es",
        "example": "books, buses, watches"
      },
      {
        "rule": "Irregular: man → men, child → children",
        "example": "two women, three children"
      },
      {
        "rule": "this/that + singular · these/those + plural",
        "example": "this phone, these phones"
      }
    ],
    "trap": {
