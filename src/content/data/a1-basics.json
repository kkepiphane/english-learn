      },
      {
        "id": "a1ps-4",
        "type": "gap",
        "prompt": "My father ___ (work) at night.",
        "accepted": [
          "works"
        ],
        "explanation": "he → works."
      },
      {
        "id": "a1ps-5",
        "type": "truefalse",
        "prompt": "\"Does he speaks French?\" is correct.",
